# ─────────────────────────────────────────────────────────────
# AgentSociety 工作区环境变量模板
#
# 用法：复制为 .env 并填入你自己的凭据
#   cp env.template .env
#
# 说明：
#   1. 本模板不含任何真实凭据，标 <...> 的位置必须替换。
#   2. `.env` 已被 .gitignore 忽略（2026-09-13 起），不会入库；
#      请把真实凭据只放在 `.env`，不要写进本文件。
#   3. PYTHON_PATH / WORKSPACE_PATH 是打包机器上的绝对路径，请改成本机的。
#   4. BACKEND_PID 是运行时状态而非配置项，运行时会自行写入，留空即可。
# ─────────────────────────────────────────────────────────────

# ── LLM（主模型；实验仿真全部调用走这里）──────────────────────
AGENTSOCIETY_LLM_API_KEY=<填入你的 API Key，形如 sk-...>
AGENTSOCIETY_LLM_API_BASE=https://api.deepseek.com
AGENTSOCIETY_LLM_MODEL=deepseek-flash

# ── 代码生成 LLM（留空则回落主模型）───────────────────────────
AGENTSOCIETY_CODER_LLM_API_KEY=
AGENTSOCIETY_CODER_LLM_API_BASE=
AGENTSOCIETY_CODER_LLM_MODEL=deepseek-flash

# 模板缓存嵌入由 custom/envs/curation_dynamics_space.py 的进程内确定性哈希补丁
# 无需外部 embedding 服务（Ark 计划无 embedding 模型）。以下保持空/默认即可。
AGENTSOCIETY_EMBEDDING_API_KEY=
AGENTSOCIETY_EMBEDDING_API_BASE=
AGENTSOCIETY_EMBEDDING_MODEL=bge-m3
AGENTSOCIETY_EMBEDDING_DIMS=1024

# ── 后端服务 ──────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
BACKEND_LOG_LEVEL=info

# ── 本机路径（务必改成本机绝对路径）───────────────────────────
# PYTHON_PATH 需指向能 import agentsociety2 的解释器，
# 例如引擎目录下的 AgentSociety2/.venv/bin/python
PYTHON_PATH=<你的 python 解释器绝对路径>
WORKSPACE_PATH=<本工作区绝对路径>

# ── 文献检索 MCP ──────────────────────────────────────────────
LITERATURE_SEARCH_MCP_URL=https://llmapi.fiblab.net/mcp/
LITERATURE_SEARCH_API_KEY=<填入你的检索服务 Key，形如 sk-...>

# ── 运行时状态（非配置项，运行时自动写入，留空即可）───────────
BACKEND_PID=
